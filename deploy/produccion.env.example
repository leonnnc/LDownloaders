# ===========================================================================
# Configuración de PRODUCCIÓN
# Copia este archivo a deploy/produccion.env y ajusta los valores.
# produccion.env NO se sube a git.
# ===========================================================================

# --- Motor: mantenimiento automático (lo más importante) -------------------
VDL_AUTO_UPDATE=true
VDL_UPDATE_INTERVAL_HOURS=12
VDL_UPDATE_CHANNEL=stable
VDL_UPDATE_ROLLBACK=true
# Docker reinicia el contenedor cuando el actualizador sale.
VDL_RESTART_AFTER_UPDATE=true

# --- Canarios: detectar roturas antes que los usuarios --------------------
VDL_CANARY_ENABLED=true
VDL_CANARY_INTERVAL_MINUTES=30
VDL_CANARY_MIN_PASS_RATE=60
VDL_CANARY_ALERT_AFTER=3
VDL_CANARY_FILE=/app/canaries.json

# --- Alertas --------------------------------------------------------------
# IMPRESCINDIBLE en producción. Sin esto no te enteras de las caídas.
# Slack, Discord, n8n o cualquier webhook que acepte JSON por POST.
VDL_ALERT_WEBHOOK=

# --- Proxies: la capa que decide si el servicio sobrevive ------------------
# Sin proxies, los sitios grandes bloquearán la IP del servidor en días.
# VDL_PROXY=http://usuario:clave@proxy.tuproveedor.com:8080
# VDL_PROXY_MAP=youtube=http://u:p@host:8080,facebook=http://u:p@host:8081

# --- Seguridad ------------------------------------------------------------
# Genera el token con:  openssl rand -hex 24
VDL_ADMIN_TOKEN=

# Restringe los dominios que ofreces. Déjalo vacío solo si quieres
# comportarte como un proxy abierto (no recomendado).
VDL_ALLOWED_DOMAINS=facebook.com,fb.watch,instagram.com,tiktok.com

# --- Historial de descargas del panel -------------------------------------
# Guarda IP + enlace + formato + resultado de cada descarga. Es útil para
# responder a reclamaciones, pero es un dato personal: el archivo está en
# .gitignore y conviene montarlo en un volumen que no se copie a los backups,
# o apagarlo con VDL_HISTORY_ENABLED=false si no lo quieres en el servidor.
VDL_HISTORY_ENABLED=true
VDL_HISTORY_MAX=300
# VDL_HISTORY_FILE=/app/data/history.jsonl

# Carrusel público de la portada: enseña título + miniatura + plataforma de las
# últimas descargas (nunca la IP ni el enlace). Ponlo a false si no quieres que
# la portada muestre la actividad de nadie.
VDL_GALLERY_ENABLED=true
VDL_GALLERY_MAX=12
VDL_GALLERY_MIN=2

# --- Límites y abuso ------------------------------------------------------
VDL_MAX_CONCURRENT_JOBS=3
# Tope por archivo, en MB. 0 = sin límite (arriesgado en producción: un 4K largo
# puede llenar el disco y dejar el servicio sin poder aceptar nada).
VDL_MAX_FILESIZE_MB=500
VDL_FILE_TTL_MINUTES=15
# Minutos que puede estar un trabajo en curso antes de darlo por colgado. Debe
# superar la descarga legítima más larga que esperes: el recolector de basura no
# borra un trabajo activo antes de este plazo.
VDL_ACTIVE_JOB_MAX_MINUTES=120
VDL_RATE_LIMIT_REQUESTS=20
VDL_RATE_LIMIT_WINDOW=60
# Cupo aparte para entregar archivos, más holgado: reproducir un vídeo con
# saltos dispara muchas peticiones de rango y no deben gastar el cupo anterior.
VDL_RATE_LIMIT_FILES_REQUESTS=120

# --- Editor de audio (cortar, volumen, unir, fundidos) --------------------
# Exportar consume CPU del servidor, así que esto es tiempo de máquina que se
# regala a quien encuentre la página. Si no lo quieres público, apágalo aquí o
# deja /api/audio/* detrás de autenticación en el proxy inverso.
VDL_EDITOR_ENABLED=true

# Carpeta de los audios cargados y de las exportaciones. Va aparte de los
# archivos de descarga porque tiene su propio ciclo de vida (horas, no minutos).
# Descomenta solo si quieres conservarlos en un volumen; si no, se quedan en el
# sistema de archivos del contenedor y se borran solos.
# VDL_EDITOR_DIR=/app/editor

VDL_EDITOR_MAX_UPLOAD_MB=100
# Más bajo que el valor por defecto (60): 30 minutos de audio ya son varios
# minutos de CPU por exportación.
VDL_EDITOR_MAX_MINUTES=30
VDL_EDITOR_MAX_ASSETS=20
VDL_EDITOR_ASSET_TTL_HOURS=6
VDL_EDITOR_RENDER_TTL_MINUTES=30
VDL_RATE_LIMIT_AUDIO_REQUESTS=60

# --- Proxies de confianza (quién puede decir cuál es tu IP) ---------------
# Solo si el servicio está detrás de un proxy inverso PROPIO. La IP del cliente
# se lee de la ÚLTIMA entrada de X-Forwarded-For, que es la que añade tu proxy.
#
# Déjalo VACÍO si el servicio recibe conexiones directamente: entonces la IP es
# la del par real, que es el único dato que el cliente no puede falsificar.
# NUNCA pongas "*": eso hace que cualquiera pueda inventarse una IP por petición
# y saltarse el límite por completo.
#
# En el compose de producción la red `web` es 172.28.0.0/16 y Caddy vive ahí:
# VDL_TRUSTED_PROXIES=172.28.0.0/16

# --- Motor y red ----------------------------------------------------------
# El arranque usa --no-proxy-headers a propósito: uvicorn trae el manejo de
# cabeceras de proxy activado por defecto y eso deja el límite a merced del
# cliente. No lo quites sin entender el párrafo de arriba.

# --- Cookies (opcional, para contenido que exige sesión) ------------------
# VDL_COOKIES_DIR=/app/cookies

# --- Clientes de reproducción (YouTube, cuando hay bloqueos) --------------
# VDL_PLAYER_CLIENTS=default,web_safari,android
