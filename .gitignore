# ---------------------------------------------------------------
# Entorno y dependencias
# ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class

# ---------------------------------------------------------------
# Datos en tiempo de ejecucion
# ---------------------------------------------------------------
storage/
data/
downloads/
cookies.txt
cookies/

# Token de administracion generado localmente. NUNCA debe subirse:
# cualquiera con este valor puede reiniciar el servicio y borrar archivos.
ADMIN-TOKEN.txt

# ---------------------------------------------------------------
# Registros y configuracion local
# ---------------------------------------------------------------
*.log
.env
.env.*

# Configuración de producción: contiene el token de administración y el
# webhook de alertas. Solo existe en el servidor.
deploy/produccion.env

# ---------------------------------------------------------------
# Android
# ---------------------------------------------------------------
.gradle/
build/
local.properties
keystore.properties
*.jks
*.keystore
captures/
.externalNativeBuild/
.cxx/
*.iml
.idea/

# El SDK de Android es propio de cada maquina
android-sdk/

# ---------------------------------------------------------------
# Sistema operativo y editores
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.swp
*~

# Estado en tiempo de ejecucion del actualizador
backend/update_state.json

# Historial de descargas del panel: contiene direcciones IP y enlaces, que son
# datos personales de quien uso el servicio. No debe acabar en el repositorio.
backend/history.jsonl
history.jsonl

# Informes internos de revision tecnica: describen fallos de seguridad que
# todavia no estan corregidos. El repositorio es publico, asi que se quedan fuera.
REVISION.md
REVISION-*.md

# Datos del editor de audio: los archivos que sube el usuario (y las
# exportaciones) son suyos, no del repositorio. Caducan solos por TTL.
backend/editor/

# Capturas y diagnosticos de trabajo: no forman parte del servicio.
shot-*.png
diagnostico-menu/
*.log.prev

# Copias de seguridad locales: pueden llevar datos de uso (la del historial
# tiene direcciones IP) y no forman parte del servicio.
*.bak

# Capturas de trabajo: sirven para revisar un cambio, no para el repositorio.
captura-*.png
